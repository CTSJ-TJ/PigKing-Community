<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ctsjmain.mapper.UserMapper">
    <select id="login" resultType="com.example.ctsjmain.entity.User" parameterType="com.example.ctsjmain.entity.User">
        select * from myuser where username=#{username} and userpwd=#{userpwd}
    </select>

    <insert id="add" parameterType="com.example.ctsjmain.entity.User" useGeneratedKeys="true">
        insert into myuser values(null,#{username},#{userpwd},null,null,null,null,curdate(),1)
    </insert>

    <select id="find" resultType="com.example.ctsjmain.entity.User" parameterType="string">
        select * from myuser where username like "%"#{values}"%" or userid=#{values}
    </select>
</mapper>
